ANTHROPIC_API_KEY=sk-ant-...
PORT=3000
MODEL=claude-haiku-4-5-20251001
DEBUG=

# Optional: ElevenLabs TTS. Absent disables the audio path entirely (browser SpeechSynth still narrates).
ELEVENLABS_API_KEY=
# Required when ELEVENLABS_API_KEY is set. User-provisioned custom voice id.
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_turbo_v2_5 (lower latency, cheaper per-char).
ELEVENLABS_MODEL_ID=
# Optional. Daily character cap kill-switch. Default 30000 (~Starter tier). Counter resets on process restart.
ELEVENLABS_DAILY_CHAR_CAP=
